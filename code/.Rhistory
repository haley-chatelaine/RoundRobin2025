names(overlap.mf.list) <- mf.unique
# Add abundance data
for(mf in 1:length(overlap.mf.list)){
if(mf.unique[mf] %in% overlap.feats$Lab1$MF &
mf.unique[mf] %in% overlap.feats$Lab2$MF &

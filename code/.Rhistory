plots.nmf.avg <- mapply(function(x,y,z) (pheatmap::pheatmap(t(x[order(meta.data.avg$group),]), cluster_rows = F, cluster_cols = F, main = paste0(y, " - ", z),
color = colors,
show_rownames = T,
show_colnames = T,
fontsize = 20,
silent = TRUE)$gtable),
nmf.scaled.data.avg,
names(nmf.scaled.data.avg),
mf.names,
SIMPLIFY = FALSE)
pdf(file = "/Users/chatelaineha/Documents/Beecher_Collaboration/Writing/data_code/outputs/heatmap_NMF_feats_averaged.pdf", width = 24, height = 16)
grid.arrange(grobs = plots.nmf.avg, ncol = 4)

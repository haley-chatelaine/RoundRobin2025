mf.unique[mf] %in% overlap.feats$Lab5$MF &
mf.unique[mf] %in% overlap.feats$Lab6$MF &
mf.unique[mf] %in% overlap.feats$Lab7$MF &
mf.unique[mf] %in% overlap.feats$Lab8$MF){
# add empty data frame to list
overlap.mf.list[[mf]] <- data.frame(matrix(nrow = 8, ncol = nrow(norm.impute$Lab1)))
colnames(overlap.mf.list[[mf]]) <- row.names(norm.impute$Lab1)
row.names(overlap.mf.list[[mf]]) <- names(norm.impute)
# add abundance data for the feature from the filtered feature list for each MF for each lab
overlap.mf.list[[mf]][1,] <- norm.impute$Lab1[,which(row.names(comp.std$Lab1) == overlap.feats$Lab1$feature[which(overlap.feats$Lab1$MF == mf.unique[mf])])]
overlap.mf.list[[mf]][2,] <- norm.impute$Lab2[,which(row.names(comp.std$Lab2) == overlap.feats$Lab2$feature[which(overlap.feats$Lab2$MF == mf.unique[mf])])]
overlap.mf.list[[mf]][3,] <- norm.impute$Lab3[,which(row.names(comp.std$Lab3) == overlap.feats$Lab3$feature[which(overlap.feats$Lab3$MF == mf.unique[mf])])]
overlap.mf.list[[mf]][4,] <- norm.impute$Lab4[,which(row.names(comp.std$Lab4) == overlap.feats$Lab4$feature[which(overlap.feats$Lab4$MF == mf.unique[mf])])]
overlap.mf.list[[mf]][5,] <- norm.impute$Lab5[,which(row.names(comp.std$Lab5) == overlap.feats$Lab5$feature[which(overlap.feats$Lab5$MF == mf.unique[mf])])]
overlap.mf.list[[mf]][6,] <- norm.impute$Lab6[,which(row.names(comp.std$Lab6) == overlap.feats$Lab6$feature[which(overlap.feats$Lab6$MF == mf.unique[mf])])]
overlap.mf.list[[mf]][7,] <- norm.impute$Lab7[,which(row.names(comp.std$Lab7) == overlap.feats$Lab7$feature[which(overlap.feats$Lab7$MF == mf.unique[mf])])]
overlap.mf.list[[mf]][8,] <- norm.impute$Lab8[,which(row.names(comp.std$Lab8) == overlap.feats$Lab8$feature[which(overlap.feats$Lab8$MF == mf.unique[mf])])]
}
}
